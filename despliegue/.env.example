# Copiar como .env en esta misma carpeta (despliegue/) y completar. El .env no se sube al repo.

# MySQL
MYSQL_ROOT_PASSWORD=
DB_USER=ferreteria
DB_PASSWORD=

# El mismo JWT_SECRET en los 3 servicios: Base64 de 32 bytes o más (openssl rand -base64 32)
JWT_SECRET=
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=7

# La misma clave en ms-catalogo y ms-ventas (openssl rand -base64 32)
INTERNAL_API_KEY=

# Opcional: carpetas de los repos, si no se llaman como en el contrato (rutas relativas a despliegue/)
# USUARIOS_DIR=../../ferreteria-ms-usuarios
# CATALOGO_DIR=../../ferreteria-ms-catalogo
# VENTAS_DIR=../../ferreteria-ms-ventas
